# Copia este archivo a .env y completa los valores.
PORT=3000
HOST=0.0.0.0

# Base de datos Postgres (Neon). Usa la "connection string" con sslmode=require.
DATABASE_URL="postgresql://usuario:clave@host/neondb?sslmode=require"

# Firma de tokens de sesión (mínimo 32 caracteres aleatorios)
AUTH_SECRET=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
